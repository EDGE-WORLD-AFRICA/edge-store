{
  "name": "@edge-store/api",
  "version": "1.0.0",
  "description": "Edge Store Backend API",
  "main": "dist/index.js",
  "type": "module",
   "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile src/knexfile.ts",
    "migrate:rollback": "tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile src/knexfile.ts",
    "migrate:make": "tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile src/knexfile.ts",
    "seed": "tsx ./node_modules/knex/bin/cli.js seed:run --knexfile src/knexfile.ts",
    "seed:make": "tsx ./node_modules/knex/bin/cli.js seed:make --knexfile src/knexfile.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@edge-store/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mysql2": "^3.6.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
    "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
    },
    "seeds": {
      "directory": "./src/db/seeds"
    }
  },
  "production": {
    "client": "mysql2",
    "connection": {
      "host": "127.0.0.1",
      "port": 3306,
      "user": "root",
      "password": "",
      "database": "edge_store"
    },
    "pool": {
      "min": 2,
